
<IfModule mod_rewrite.c>
RewriteEngine On

# Reindirizzamento www verso tourneurs.it
RewriteCond %{HTTP_HOST} ^www\.tourneurs\.it$ [NC]
RewriteRule ^(.*)$ https://tourneurs.it/$1 [R=301,L]

# Homepage senza index.html
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=302,L]

# Rimuove .html dagli indirizzi
RewriteCond %{THE_REQUEST} \s/+[^\s?]+\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=302,L]

# Carica internamente i file HTML
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

</IfModule>

DirectoryIndex index.html
